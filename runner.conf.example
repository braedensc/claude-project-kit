# runner.conf.example — what the runner's installer reads (docs/RUNNER.md, "Installing it").
#   cp runner.conf.example runner.conf && chmod 600 runner.conf; edit it; none of it is secret
#   python3 scripts/pipeline_runner_setup.py check     # read it first; the one command runs `apply`
# Runs beside an EXISTING Stage E install, from its clone. KEY=value, parsed never sourced; no key holds a
# credential. `~` is the ROLE ACCOUNT's home. Every fault is reported at once, by key and never by value.
# The installer writes every lane off for every project. Switching one on is your yes, per project.

ROLE_ACCOUNT=_exrunner
ROLE_KIT_CLONE=~/.stage-e/kit
ENV_FILE=~/.stage-e/env
JOB_LABEL=local.pipeline-runner

# The runner's own folder: its settings (runner.json), log, store, workspaces, the sessions' home, and
# tracker-key, a file of the role account's (mode 0600) that holds the runner's tracker key. It is NOT in this
# file: `python3 scripts/pipeline_runner_setup.py tracker-key` asks for the key at a hidden prompt and for the
# day it ends, writes the file, and records the date where the health watch warns from it.
RUNNER_DIR=~/.pipeline-runner
# The claude program's full path, and the NAME of the variable in ENV_FILE that holds its sign-in token.
CLAUDE_BIN=/opt/homebrew/bin/claude
TOKEN_ENV=CLAUDE_WRITER_OAUTH_TOKEN

# The sessions' push token: a file of the role account's (mode 0600) that holds one GitHub token. It is NOT
# in this file. `python3 scripts/pipeline_runner_setup.py push-token` asks for the token at a hidden prompt and
# for the day it ends, writes the file, and records the date where the health watch warns from it. Unset, it is
# `push-token` inside RUNNER_DIR. It may not sit in the runner's work, home or store folder.
PUSH_TOKEN_FILE=~/.pipeline-runner/push-token

# The session writer's key: a file of the role account's (mode 0600) that holds one tracker key, for the user
# `session_tools.writer_user_id` names. Made the same way: `python3 scripts/pipeline_runner_setup.py writer-key`.
# Unset, it is the `session_tools.key_file` you installed, else `writer-key` inside RUNNER_DIR. It may not sit
# in the runner's work, home or store folder, nor be the push token's or the tracker key's file.
WRITER_KEY_FILE=~/.pipeline-runner/writer-key

# Tracker user ids: the owner's, and the old dispatcher's own users (which never approve).
OWNER_USER_IDS=owner-user-id-1
DISPATCHER_USER_IDS=dispatcher-user-id-1

# Each project: KEY=PATH@BASE. A lower-case key, the runner's own clone of it, and its base branch.
PROJECTS=app=~/repos/app@main
