# update.conf.example — every value the review-and-update command reads.
#
# ---------------------------------------------------------------------------
# HOW TO USE THIS FILE
#
#   cp update.conf.example update.conf
#   $EDITOR update.conf
#   python3 scripts/pipeline_update.py review             # read-only, any time
#   python3 scripts/pipeline_update.py update dispatcher  # a person, in a terminal
#
# Guide: docs/UPDATE-OPERATOR.md.
#
# FORMAT.  `KEY=value`, one per line; `#` starts a comment only at the start of
# a line.  Parsed, never sourced.  A duplicate or unknown key is an error.  No
# value here ever holds a credential, and the command never reads one: the
# pre-flight reads only the NAMES in the dispatcher's env file.
#
# WHAT IS OPTIONAL.  Every section can be left empty.  An empty section is
# reported as "not configured on this machine", never as "current".
# ---------------------------------------------------------------------------

# --- The dispatcher --------------------------------------------------------
# All three or none.  The same values as stage-e.conf and chat-lane.conf.
# The values below are refused as typed, so an unedited file cannot run.
DISPATCHER_SERVICE=com.example.dispatcher
ROLE_ACCOUNT=_exdispatch
DISPATCHER_ENV_FILE=/opt/example-dispatcher/.env

# The port its /version and /status routes answer on, on 127.0.0.1.
DISPATCHER_PORT=3456

# The npm package the role account runs, and the version to move it to:
# `latest`, or an exact version.  Pin one when a newer release has not been
# reviewed yet — the review command then reports the pin, not the registry.
DISPATCHER_PACKAGE=cyrus-ai
DISPATCHER_VERSION=latest

# The shell line that puts the role account's Node on PATH (run under bash,
# as a login shell, before every npm command).
DISPATCHER_NODE_SETUP=. "$HOME/.nvm/nvm.sh"

# `off` adds CYRUS_SENTRY_DISABLED=1 to the env file during an update, if it is
# absent.  (The dispatcher reports errors only when a team id is set at all;
# this keeps it off even if one ever is.)  `unchanged` leaves the file alone.
DISPATCHER_SENTRY=unchanged

# Env NAMES that must be ABSENT before an update, because each one changes what
# the dispatcher does at start-up.  A trailing * matches a prefix.  A hit stops
# the update before anything changes.  Remove a name here only on purpose.
DISPATCHER_FORBIDDEN_ENV=CYRUS_API_KEY,CYRUS_TEAM_ID,CYRUS_ENABLE_WARM_SESSIONS,ZULIP_*

# --- Homebrew --------------------------------------------------------------
# Casks and formulae to compare against Homebrew's index, comma-separated.
# BREW_RESTARTS names the ones a launchd job runs, as formula:label, so the
# update line it prints restarts the job onto the new binary.
BREW_CASKS=claude-code
BREW_FORMULAE=gh,git
BREW_RESTARTS=

# --- The kit ---------------------------------------------------------------
# The checkout to compare against its origin.  Empty means the checkout this
# command runs from.  On a pipeline machine that should be the one the hooks
# run from: every session's guards are read from that checkout.
KIT_CHECKOUT=

# --- The health watch (scripts/pipeline_watch.py) --------------------------
# One hourly pass of the checks in docs/UPDATE-OPERATOR.md, "The health
# watch". It alerts only when a kind CHANGES between firing and ok.

# The status file the heartbeat monitor reads (the Slack path). It must sit
# where the dispatcher's role account can read it, so not in your home:
# /Users/Shared is the macOS place for that. Empty: no status file, and the
# monitor has nothing to read (every pass says so).
HEALTH_STATUS_FILE=

# The PRIVATE repo whose `pipeline-alert.yml` (templates/workflows/) opens and
# closes one issue per kind as github-actions[bot]. Never a public repo: the
# alert text carries machine state. Empty: GitHub alerts are OFF (said every pass).
ALERT_REPO=
ALERT_WORKFLOW=pipeline-alert.yml

# The dispatcher's public status URL, through the front door and tunnel.
# Empty: not checked.
PUBLIC_STATUS_URL=

# Free space on / below which `disk` fires, in GB.
DISK_FLOOR_GB=20

# Temp space above which `temp` fires, in GB: this account's Claude Code
# session scratch (/tmp/claude-<uid>) and its own TMPDIR, together. The
# dispatcher's account keeps its own, which the watch cannot read.
TEMP_CEILING_GB=10

# The machine's memory (KIT-609): `memory` fires when less than this percent of memory is free, or more than
# SWAP_CEILING_GB of swap is used, on two passes in a row (one spike says nothing). Read from macOS's own tools,
# without sudo. A concern, not an outage: it is listed as advisory, opens no GitHub issue and pages nobody; the
# stand-up says one line about it.
MEMORY_FREE_FLOOR_PCT=10
SWAP_CEILING_GB=4

# The burn rate (KIT-609): the usage job's file (usually ~/.stage-e/usage/usage.json). `burn` fires when the weekly
# window's use, projected to its reset from use so far and time left, reaches BURN_WEEK_PCT, or when the 5-hour
# window is at BURN_FIVE_HOUR_PCT. It reads only what the usage job already records; a figure it cannot read is
# unknown, never zero. Advisory like `memory`. Empty: not watched, and every pass says so.
BURN_USAGE_FILE=
BURN_WEEK_PCT=90
BURN_FIVE_HOUR_PCT=90

# How often the LaunchAgent runs a pass, in seconds (600 or more).
WATCH_INTERVAL_SECONDS=3600
WATCH_LABEL=local.pipeline-health-watch

# The checkouts whose hooks may leave a "could not tell which worktree"
# record, comma-separated. Empty: KIT_CHECKOUT (or this kit).
HOOK_CHECKOUTS=

# The conflict waker's state directory, where it writes heartbeat.json: its
# --state-dir, by default /Users/<you>/.pr-conflict-waker/state. When it has
# not checked in for an hour, or reports a problem, two passes running,
# `conflict-waker` fires and reaches Slack through the status file. It opens
# no GitHub issue. Empty: no conflict waker is watched (every pass says so).
CONFLICT_WAKER_STATE_DIR=

# The role account's heartbeats for the notifier and the heartbeat monitor, as
# files THIS account can read (KIT-286). The notifier cannot page about itself
# and nothing scheduled reads the monitor's own heartbeat, so each is a kind of
# this watch: its heartbeat an hour old, unreadable or missing, two passes
# running, opens a GitHub issue. The role account's state directory is not
# readable from here by default: point each at a copy that is (for example a
# file in a folder both accounts can reach), kept fresh by whoever copies it.
# Empty: that job is not watched, and every pass says so.
NOTIFIER_HEARTBEAT_FILE=
MONITOR_HEARTBEAT_FILE=

# The watcher's page job (scripts/pipeline_watcher_page.py, KIT-549): its
# page-heartbeat.json, as a file THIS account can read. When it is older than
# WATCHER_PAGE_MAX_AGE_MINUTES, unreadable, in another shape, missing, or says a
# page could not be sent (naming the route), two passes running, `watcher-page`
# fires and reaches Slack through the status file. It opens no GitHub issue.
# Empty: the page job is not watched (every pass says so).
WATCHER_PAGE_HEARTBEAT_FILE=
WATCHER_PAGE_MAX_AGE_MINUTES=120

# The yearly credentials' end dates (KIT-579): name:YYYY-MM-DD, comma separated. Names and
# dates ONLY, never a token. The `credentials` kind opens a GitHub issue once a date is within
# CREDENTIAL_WARN_DAYS (14 to 365) of today, or past; it never pages Slack. Empty: not watched.
# Move a date after you rotate that credential (docs/UPDATE-OPERATOR.md).
CREDENTIAL_EXPIRIES=
CREDENTIAL_WARN_DAYS=30
