# Distilled from a production build's .gitignore (live 2026-06-23 → 2026-07-03),
# strengthened: .env.* is deny-all with an explicit .env.example allow.

# Reference material — never published (licensed specs, exports, scratch planning).
# The PreToolUse hook and the pre-commit hook both refuse to stage this path.
planning/

# Secrets — only .env.example (placeholder values) is ever committed
.env
.env.*
.env*.local
!.env.example
*.pem
*.key
.provenance-denylist

# Dependencies
node_modules/

# Build output
dist/

# Generated-file guard: running a tool from the repo root can spawn a bogus
# root-level lockfile when the real one lives deeper (in production: a stray
# /deno.lock appeared beside supabase/functions/deno.lock). Guard such paths
# explicitly rather than discovering them in a diff.
/deno.lock

# Test artifacts (Playwright pattern — harmless if you use another runner)
test-results/
playwright-report/
playwright/.cache/
e2e/.auth/

# Husky runtime (generated by `npm install` via the prepare script)
.husky/_/

# OS
.DS_Store

# Claude Code runtime (local-only, never project config)
CLAUDE.local.md
.claude/audit.log
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/
.claude/.stop-pr-nag/

# Compiled Python (hooks + scripts). Generic on purpose: a path-scoped
# entry left scripts/__pycache__/ untracked-but-stageable, and no gate
# objects to a .pyc — the CI forbidden-paths regex, the pre-commit gate,
# secretlint and the provenance scan all pass it, so a `git add -A` would
# publish build artifacts (and the absolute build path baked into them).
__pycache__/
*.pyc
