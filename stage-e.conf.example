# stage-e.conf.example — every value the Stage E installer asks you for.
#
# ---------------------------------------------------------------------------
# HOW TO USE THIS FILE
#
#   cp stage-e.conf.example stage-e.conf && chmod 600 stage-e.conf
#   $EDITOR stage-e.conf             # eleven values to fill in, none of them secret
#   python3 scripts/pipeline_stage_e_setup.py run    # the only command you type
#
# `run` validates this file before it touches anything, and reports EVERY bad
# value in one pass — not the first one it meets. Fix them all, run it again.
#
# ---------------------------------------------------------------------------
# WHAT THIS FILE IS, AND WHAT IT MAY NEVER BE
#
#   FORMAT.  `KEY=value`, one per line.  `#` starts a comment ONLY at the start
#   of a line: everything after the first `=` is the value.  No quotes, no line
#   continuations, no `export`, no `$(…)`, no backticks.
#
#   IT IS PARSED, NEVER SOURCED.  A conf that can execute code is a conf that
#   executes it under `sudo`, and this one is read by a process that holds it.
#
#   A DUPLICATE KEY IS A HARD ERROR, naming both line numbers.  Last-wins hides
#   the effective value, and an invisible effective value is the defect class
#   this whole kit is shaped against.
#
#   NO KEY HERE EVER HOLDS A CREDENTIAL.  The loader refuses to start if any
#   value carries a credential shape, and it names the KEY only, never the
#   value.  Both secrets are typed at a hidden prompt, once, and written
#   straight into the role account's own env file at mode 600.  Nothing about
#   them is stored here, printed, or logged — only the env var NAME.
#
#   MODE 600.  This file holds no secret, but it does hold the shape of your
#   deployment.  `stage-e.conf` is gitignored; this example is committed.
#
#   EVERY EXAMPLE VALUE BELOW IS RESERVED OR SYNTHETIC.  The organisation is
#   `example-org`, the domain is `example.com` (RFC 2606, deliverable to
#   nobody), the role account is the namespaced `_exdispatch`.  Two values are
#   deliberately left as placeholders that the validator REFUSES by name, so a
#   conf nobody edited cannot be run by accident: OWNER_LINEAR_EMAIL and
#   REVIEW_REPOS.
#
# ---------------------------------------------------------------------------


# ===========================================================================
# 1.  THE MACHINE — who Stage E runs as, and where the dispatcher already lives
# ===========================================================================

# The non-admin macOS account the dispatcher runs as, and that Stage E's three
# daemons will run as too.  NOT your login account: a user LaunchAgent only
# runs while you are logged in, so a poller under your account stops the moment
# you log out while the dispatcher keeps opening pull requests — reviews would
# stop silently.  The installer reads this account's home from the directory
# service; you never type a home path.
#
# RULE: an existing local account, resolvable by `dscl . -read /Users/<name>`.
# The installer never creates it — if it is missing, that is the dispatcher
# install, not this one.
ROLE_ACCOUNT=_exdispatch

# The launchd label of the dispatcher's own system daemon.  The installer
# restarts it (unload-then-load) after writing the reviews entry, and reads its
# startup banner back.  It is also the source of the Stage E daemon labels: the
# reverse-DNS prefix is reused, so `com.example.dispatcher` yields
# `com.example.stage-e-poller`, `com.example.stage-e-bounce` and
# `com.example.stage-e-finding`.
#
# RULE: reverse-DNS, at least two dot-separated segments, and a service that
# `launchctl print system/<label>` can find.
DISPATCHER_SERVICE=com.example.dispatcher

# The dispatcher's config file — the one holding its `repositories` array.  The
# installer backs it up under the role account's own home (never beside this
# file — see CONFIG_BACKUPS_KEPT), inserts or updates ONE ENTRY PER REVIEWED
# REPOSITORY in it (`reviews-<name>`, one clone each), removes the single
# `reviews` entry an older installer wrote, and validates that the result still
# parses.  It writes nothing else there.  A review runs in the entry its tag
# names, so a shared entry would put a reviewer in the wrong repository's clone.
#
# RULE: an absolute path to a readable JSON file owned by ROLE_ACCOUNT.  The
# installer reads `workspaceBaseDir`, `linearWorkspaceId`, `repositoryPath` and
# every entry `name` out of it, so you type none of those.
DISPATCHER_CONFIG=/opt/example-dispatch/config.json

# The clone URL the four daemons exec out of.  The installer clones it under
# the role account at `~/.stage-e/kit`, SEPARATE from whatever clone the
# dispatcher cuts worktrees from, so a fetch never moves code under a running
# pass.  EVERY run compares that clone's HEAD against origin's and fast-forwards
# it when it is behind (`fetch` + `pull --ff-only`), with the daemons unloaded
# for the move.  It once decided by listing FILENAMES instead, which never
# change when their contents do — so a merged fix stayed inert on the machine
# while every command on the box reported it current.
#
# RULE: an https git URL.  Not a path, not ssh — the role account has no keys.
KIT_REPO_URL=https://github.com/example-org/claude-project-kit


# ===========================================================================
# 2.  THE TRACKER — the work teams, the agent, and you
# ===========================================================================

# There is no Reviews team.  Each review ticket is filed on the coding ticket's
# own work team (one of MANAGED_TEAM_KEYS, below), carrying the tag
# [repo=reviews-<name>] and the workspace label reviews-<name>, which only that
# repository's review entry routes on.  The installer creates that label for
# each repository in REVIEW_REPOS.  It creates no team and no workflow state,
# and never reads or changes a team's git automations: those move your coding
# tickets into review.
#
# An older stage-e.conf has REVIEWS_TEAM_KEY and REVIEWS_TEAM_NAME.  They are
# retired: accepted, ignored, and named in the run's notes.  Delete both lines.
# Moving a live install off its Reviews team: docs/STAGE-E-OPERATOR.md,
# "Moving off a Reviews team".
#
# CREATING A LABEL IS ADMIN-SCOPED on some workspaces.  If the run says the
# label create was refused, make the label by hand at WORKSPACE scope, named
# exactly reviews-<repository name>, and run again.

# The DISPLAY NAME of the dispatcher's Linear agent user — the identity a
# review ticket is delegated to.  This is usually lower-case and is NOT the
# capitalised label the members list shows you.
#
# RULE: matches exactly one active app user in the workspace.  If the name is
# ambiguous the installer stops and names both, rather than guessing.
AGENT_DISPLAY_NAME=dispatcher-agent

# The workspace label that selects the reviewer's model.  A review is a cheap,
# bounded read, so the cheap model is the right default; the poller attaches
# this label when it creates each review ticket.
#
# RULE: an existing WORKSPACE-level label.  A team-scoped label with the same
# name does not count — the dispatcher reads labels off a ticket by name, and a
# label scoped to one team is invisible to every other team's tickets.  The
# installer says so explicitly rather than counting it.
MODEL_LABEL=haiku

# Your own Linear account, by email.  The installer resolves it to a user id
# and writes that id into the reviews entry's `userAccessControl.allowedUsers`,
# so only delegations made by you can start a reviewer session.
#
# RULE: an address that resolves to exactly one active member.  LEFT INVALID ON
# PURPOSE — `you@example.com` is refused by name, so an unedited conf cannot
# run.
OWNER_LINEAR_EMAIL=you@example.com

# The team keys whose tickets Stage E treats as pipeline work, comma-separated.
# Review tickets are filed on these teams: on the coding ticket's own team, so a
# ticket on a team not named here gets no review.  The agent must already be a
# member of each (card CK-4 says which, if not); the installer never changes a
# team's members.
#
# REQUIRED, AND EMPTY IS NOT "ANY TEAM".  The finding poller scans exactly these
# teams for the side-findings a session reports, and it refuses an empty list —
# a scan of no teams is a component that cannot say what it did.  Left empty,
# every other check passes and the run dies at that component's dry run, at exit
# 1, with no checkpoint card.  The validator now names this key instead.
#
# RULE: comma-separated team keys, 1-10 upper-case letters or digits each, at
# least one.
MANAGED_TEAM_KEYS=KIT,TOD

# The dispatcher's own port on this machine.  The review poller reads its
# version at http://127.0.0.1:<port>/version and pauses reviews on any version
# other than the one the routing probe was signed on.  The idea gate's
# installer reads the same port.
#
# RULE: a port number.  Default 3456.
DISPATCHER_PORT=3456

# The ticket the heartbeat monitor comments on.  A decision, not a default: a
# ticket id, or `off`.
#
# Each daemon writes a heartbeat after every pass, so that "it stopped" and "it
# had nothing to do" stop looking alike.  Nothing reads them unless this job
# runs.  It is a fifth system LaunchDaemon under the same role account, running
# `pipeline_heartbeat_monitor.py`: deterministic code, no model, no session.  When
# the four daemons' health changes it posts ONE comment on the ticket named
# here, and one more when it recovers.  It cannot see the Mac asleep or off, or
# its own death (KIT-45) — docs/HEARTBEAT-MONITOR.md lists what it cannot catch.
#
# WHICH TICKET.  Pick one you read that no session is ever delegated, and that
# stays open.  A closed ticket can auto-archive, and the monitor's lookup then no
# longer finds it.  Sessions hold workspace-wide tracker write, so a session can
# move or archive any ticket it can reach, this one included.  Every comment the
# monitor owes then fails, and only the installer's `verify` shows it (no ticket
# yet; docs/STAGE-E-OPERATOR.md, Accepted risks).
#
# Left EMPTY, the installer stops at card CK-9 and asks you to name a ticket.
# Before loading the job it checks the ticket exists and runs the monitor's own
# `check`.
#
# RULE: a ticket id like KIT-123 that the tracker key can read, or `off`, which
# leaves the heartbeats unread BY NAME and removes a monitor an earlier run
# installed.
HEARTBEAT_MONITOR_TICKET=


# ===========================================================================
# 3.  THE REPOSITORIES under review
# ===========================================================================

# The repositories whose pull requests may be reviewed and bounced, as
# OWNER/NAME, comma-separated.
#
# WHAT THE INSTALLER DOES WITH THIS.  For each one it reads the branch's
# REQUIRED CHECK CONTEXTS from GitHub using YOUR `gh` login — which has the
# administration read your daemon token deliberately does not — and writes them
# into the bounce driver's `required_checks` map.  That map is LOAD-BEARING,
# not tuning: the daemon token gets a 403 from the protection endpoint, the
# driver refuses to read that as "requires nothing", and every pass would exit
# 2 and say so on the pull request.  A repository answered from config can
# never reach that state.
#
# If GitHub will not name the contexts for a repository, the installer does NOT
# invent an empty set: it raises checkpoint card CK-6 with the exact command,
# and blocks.
#
# That map is written VERBATIM — every required context, including any that
# waits on a person.  Which of them a session can actually fix is a separate
# question, answered by HUMAN_PENDING_CHECKS below.
#
# RULE: OWNER/NAME entries, comma-separated, each readable by your `gh` login.
# LEFT INVALID ON PURPOSE — `example-org/repo-name` is refused by name.
REVIEW_REPOS=example-org/repo-name


# ===========================================================================
# 4.  OPTIONAL — each has a default, and one default needs a file
# ===========================================================================
#
# Every default below works as shipped, except CONFLICT_WAKER_CONF's.  That
# default names conflict-waker.conf, beside this file, and that file must
# exist (no ticket yet).  Copy it from conflict-waker.conf.example, or set the
# key to `off`.

# How often each one-shot pass runs, in seconds — one per daemon: the review
# poller, the bounce driver, and the finding poller that turns a session's
# side-findings into backlog tickets (the catch-up poller's is below).  They are
# loaded at their own moments, and no stagger is promised: their outcome-file writes are
# atomic, so starting together is harmless.  The review poller and the
# bounce driver run every two minutes, so a pull request waits minutes, not a quarter of
# an hour, for its review and its ready note (KIT-310); an empty pass is a few API reads.
# All four are one-shot (scan → act →
# exit) with no KeepAlive:
# KeepAlive would restart a one-shot process in a tight loop.
POLL_INTERVAL_SECONDS=120
BOUNCE_INTERVAL_SECONDS=120
FINDING_INTERVAL_SECONDS=300

# The catch-up poller (docs/CATCH-UP.md): a delegation the dispatcher never
# received, because this machine slept or was off past Linear's retries, is
# re-prompted once in its own thread, after 7 h 30 min.  It acts only while
# the dispatcher answers locally and, if set, the public front door answers.
# RULE: CATCHUP_DISPATCHER_URL is the dispatcher's own base URL on this
# machine; CATCHUP_FRONT_DOOR_URL is the public status URL, or EMPTY to judge
# by the local answer alone.  A wrong URL stops the install at its dry run.
# CATCHUP_WEBHOOK_ID: leave EMPTY.  Set it only when the job says it sees
# several OAuth-application webhooks and cannot tell which is the dispatcher's;
# it names them.  CATCHUP_MAX_PAGES: raise it only when the job says its read
# of agent sessions was cut short (50 per page).
# It is installed only once you sign its first count (card CK-11): until then
# it is simply not installed, and nothing else waits on it.  To decline it for
# good, set CATCHUP_INTERVAL_SECONDS=off.
CATCHUP_INTERVAL_SECONDS=900
CATCHUP_MAX_PAGES=10
CATCHUP_DISPATCHER_URL=http://127.0.0.1:3456
CATCHUP_FRONT_DOOR_URL=
CATCHUP_WEBHOOK_ID=

# The watcher's hold file (docs/WATCHER.md).  While this file exists, the bounce
# driver sends no re-prompt and the catch-up job re-prompts nothing; each says so
# on every pass.  Only you clear it, with scripts/pipeline_hold.py.
# RULE: an absolute path, or ~/ for the role account's home, in a folder no
# worker can write -- never inside a git working tree.  EMPTY: the watcher
# cannot stop either job, and each says so on every pass.  Set it only once
# origin carries the hold; the installer refuses a clone that does not.
HOLD_FILE=

# The status job (contract section 16): one file of where every plan stands,
# its pull requests, checks, reviews and merges.  The Slack tech lead reads it
# instead of GitHub.  It reads the tracker and GitHub with this file's two
# credentials, and the review records, and writes only that file.
# RULE: STATUS_FILE is an absolute path, or EMPTY for the role account's own
# ~/.stage-e/status/pipeline-status.json.  The heartbeat monitor reads the same
# file as the job's heartbeat.
# Its dry run must read the tracker before it is installed (card CK-12): until
# then it is simply not installed, and nothing else waits on it.  To decline
# it for good, set STATUS_INTERVAL_SECONDS=off.
STATUS_INTERVAL_SECONDS=900
STATUS_FILE=

# Required checks that are red at a PERSON, not at the code.
#
# A check can be required and still be nothing a session can fix.  The kit's own
# grader-path guard is the example: it fails every pull request that touches a
# guarded path until someone applies the `hooks-change` label, and no push the
# session makes will turn it green.  The bounce driver sets these aside before it
# judges CI, so such a pull request is never treated as terminally red — a bounce
# spent re-prompting a session to apply a label it cannot apply is the whole
# budget spent on nothing.
#
# They are never hidden.  Every name here that is not passing is reported in the
# driver's verdict line, in `decide --json`, and inside the re-prompt itself as
# explicitly not the session's to touch.  The required set is still written out
# in full: this key decides what a bounce may be spent on, and subtracts nothing.
#
# The installer tells you what this bought.  A name that matches no required
# context on any reviewed repository buys nothing, and the run says so and lists
# what IS required — a typo here is silent otherwise.
#
# Leave it EMPTY to judge every required check.  That is a choice with a price:
# a label-pending check will then spend a bounce.
#
# RULE: check NAMES exactly as the code host shows them, comma-separated.  A
# check whose own name contains a comma cannot be written here — name it in the
# driver's `human_pending_checks` config directly.
HUMAN_PENDING_CHECKS=Hooks change guard

# The local half of the conflict loop — YOUR conflict waker.
#
# Everything above runs as the role account and serves the dispatcher.  When a
# dispatcher's pull request goes CONFLICTING, the bounce driver sends it back to
# that session's own thread, inside its sandbox.  Your LOCALLY spawned sessions
# have no such thread: when their pull requests go CONFLICTING, the conflict
# waker starts a capped fix session in the worktree they worked in.  It runs as
# YOU, as a LaunchAgent (your `claude` and `gh` logins live in your keychain),
# and only while you are logged in.  The installer's `conflict-waker` step sets
# it up from this file; `pipeline_conflict_waker_setup.py` does the same on a
# machine with no dispatcher.
#
# RULE: a path to a conflict-waker.conf (beside this file, or absolute) — copy
# conflict-waker.conf.example — or `off`, which leaves the waker off BY NAME:
# a local session's conflicted pull request then pages you instead.
#
# The default is not a working default.  The file it names must exist, or the
# `conflict-waker` step fails and says so (no ticket yet).
CONFLICT_WAKER_CONF=conflict-waker.conf

# How often the heartbeat monitor runs, in seconds (its ticket is in section 2).
# A daemon that stops is reported within about this long plus twice that
# daemon's gap: its own interval above plus 900 s, the longest one pass may run.
# At the defaults that is about 70 minutes.
#
# RULE: a positive integer.
MONITOR_INTERVAL_SECONDS=1800

# The human-action notifier's launchd label, so the heartbeat monitor watches
# the notifier too — the job that turns the monitor's comments into chat pings
# (docs/NOTIFIER-OPERATOR.md).  Set it to the notifier's own JOB_LABEL once the
# notifier is loaded.
#
# Set, the `heartbeat-monitor` step asks launchd what it runs under that label
# and how often, reads the notifier's pass time and state directory from
# ~/.stage-e/notifier.json as the role account, and watches it at that interval
# plus one pass.  The notifier must run with that config file: one started on
# another --config is refused, by name.
#
# A PAUSED notifier (unloaded, its plist still in /Library/LaunchDaemons) is
# left unwatched on that run, and the row says so; the step does not fail.
# Load it, then run this installer again to watch it.  A label with no loaded
# job and no plist is refused, and the `code` step asks before it stops any
# job, so a refusal leaves everything loaded.
#
# A dead notifier still cannot page about itself.  The monitor's comment lands
# on its ticket and says it pinged nobody; only an off-box check covers that
# (KIT-45).
#
# RULE: a reverse-DNS launchd label, or EMPTY, which leaves the notifier
# unwatched and says so by name on every run.
NOTIFIER_JOB_LABEL=

# The owner's hourly health watch (scripts/pipeline_watch.py,
# docs/UPDATE-OPERATOR.md).  It checks what no daemon reports on itself: hooks
# that cannot tell a session's worktree, updates due, a dispatcher or front
# door that is down, a full disk.  It writes one world-readable status file.
#
# Set, the heartbeat monitor reads that file as one more heartbeat.  A problem
# the watch finds then pages chat like a daemon that is down, once per set of
# problems.  A watch that stopped writing reads as stale.  Install the watch
# first (`python3 scripts/pipeline_watch.py install`): until it writes the
# file, the monitor pages it as missing.
#
# RULE: the same absolute path as HEALTH_STATUS_FILE in update.conf, or EMPTY,
# which leaves the watch unread and says so by name on every run.
HEALTH_STATUS_FILE=
# RULE: the same value as WATCH_INTERVAL_SECONDS in update.conf (at least 600).
HEALTH_WATCH_INTERVAL_SECONDS=3600

# The model a filed finding runs on, once you hand it to the agent.  The finding
# poller writes it as a `[model=...]` line opening the ticket.  The dispatcher's
# default model also runs the chat bot, so set this BEFORE you move that default,
# or a finding you hand over moves with it.  A finding filed before you set it has
# no line.  The line beats a model label, so to run one finding on another model,
# edit its line.  Review tickets carry MODEL_LABEL instead, which a default
# never moves.
#
# RULE: fable, opus, sonnet, haiku or a claude- model name, in lower case, or
# EMPTY, which files findings with no tag.
TICKET_MODEL=

# A stronger reviewer for risky changes.  When a PR changes a guarded path, the
# poller puts THIS label on its review ticket instead of MODEL_LABEL.  Guarded
# means the kit's grader paths (guards, CI workflows, the check_ and pipeline_
# scripts, the secret scan's rules) plus the autonomy.riskPaths that each
# repository's delivery.json names on its default branch.  Set it one step
# stronger than MODEL_LABEL: sonnet over the default haiku.  A cheap reviewer
# has rated guard changes low that a stronger one found high.  If MODEL_LABEL
# already names a strong model, keep that model here and move MODEL_LABEL down
# a step: guard changes keep the strong reviewer, and every other review costs
# less.  Empty: every review gets MODEL_LABEL, as before.  The installer
# creates the label if it is missing.
#
# RULE: a WORKSPACE-level label name, like MODEL_LABEL, or EMPTY.  Set it only
# once the role account's clone carries the change; the installer checks.
MODEL_LABEL_GUARDED=

# The severity at or above which review findings are called out in the pull
# request comment.  The BOUNCE threshold is a different number and comes from
# each repository's own `delivery.json` on its committed default branch.  Keep
# the two equal, or a comment saying *below threshold, comments only* can be
# followed minutes later by a bounce.
#
# RULE: one of low | medium | high | critical.
SEVERITY_THRESHOLD=medium

# The NAMES — never the values — of the two environment variables the daemons
# read their credentials from.  The installer writes both into the role
# account's own env file (mode 600, under that account's home), and refuses to
# write into the dispatcher's env file or under its state root: the dispatcher's
# env file is copied unscrubbed into every session, and the state root is
# reachable by the very sessions the ledger counts.
#
# You may rename the Linear one freely.  LEAVE THE GITHUB ONE AS `GH_TOKEN`:
# the shared comment transport reads `GH_TOKEN` and `GITHUB_TOKEN` and nothing
# else, and the bounce driver does not mirror a renamed variable — rename it
# and its reads keep working while every comment it posts fails, weeks later,
# at exhaustion time.  If you set it to `GITHUB_TOKEN`, keep no `GH_TOKEN` line
# in that env file: `gh` and the transport read `GH_TOKEN` first, so that line
# would be the token in use.  `verify` reports one, and `run` removes it.
#
# RULE: an environment variable NAME (`[A-Z][A-Z0-9_]*`).  A value with a
# credential shape here is refused, by key name.
LINEAR_KEY_ENV=STAGE_E_LINEAR_API_KEY
GITHUB_TOKEN_ENV=GH_TOKEN

# Stage E's own GitHub app (docs/STAGE-E-OPERATOR.md, Step 7).  Without one,
# the review poller posts every review as the login of the token above.  Every
# session on this Mac can post as that login too, so the validator reads those
# reviews as untrusted.  An app has a bot login of its own, `<slug>[bot]`, and
# its key is a file only the role account can read.
#
# You do not type these.  `python3 scripts/pipeline_stage_e_app.py run --conf
# stage-e.conf --test-pr OWNER/NAME#N` makes the app, writes its key file,
# posts one test comment as the app, and adds all three keys here.  Then the
# installer's `github-app` step checks, read-only, on every run and `verify`:
# the key file, the app's id and login as GitHub reports them, the app on every
# REVIEW_REPOS repository, and the test comment's author.
#
#   GITHUB_APP_ID        the app's number.
#   GITHUB_APP_LOGIN     the login its comments post under: its slug, then
#                        `[bot]`.  Never `github-actions[bot]`: every workflow
#                        run posts as that login, and a session can start one.
#   GITHUB_APP_KEY_FILE  the absolute path of its private key: in the role
#                        account's home, mode 600, owned by ROLE_ACCOUNT.  The
#                        key stays in that file; this file names it, no more.
#
# RULE: all three, or all three EMPTY.  Empty: Stage E posts as the token's own
# login, as before, and the `github-app` row says so on every run.  Set them
# only once origin carries the change; the installer checks.
GITHUB_APP_ID=
GITHUB_APP_LOGIN=
GITHUB_APP_KEY_FILE=

# How many copies of the dispatcher's config to keep.  Before it rewrites that
# file the installer copies it — into the ROLE ACCOUNT'S OWN HOME, at
# `~/.stage-e/backups/<config name>.<timestamp>`, mode 600 in a mode-700
# directory — and then deletes all but the newest this many.
#
# WHY NOT BESIDE THE ORIGINAL, which is where you would put it by hand: that
# config holds the dispatcher's tracker OAuth access and refresh tokens, so
# every copy is another live credential on disk.  The sandbox denies sessions
# the role account's home and nothing else, so a copy anywhere in the
# dispatcher's own tree is a copy every session can read — and copies that
# nothing prunes only accumulate.  Make yours in the same place.
#
# RULE: a positive integer.  Zero would delete the copy the installer just
# took, which is the one thing it refuses to rewrite the config without.
CONFIG_BACKUPS_KEPT=5

# The ceiling on the whole review-ticket description, including the diff.  Over
# it the poller declines and says so on the pull request rather than delivering
# a truncated diff a reviewer would judge as if it were whole.
#
# RULE: a positive integer.
DIFF_CAP_CHARS=120000

# How many days a closed or merged pull request's review files stay in the review
# poller's state before the poller removes them (KIT-481): its outcome, telemetry and
# re-review request, then its record. Nothing else is removed, and a pull request that
# is still open keeps everything. Whole days.
#
# RULE: a whole number. 0 keeps them for ever.
STATE_KEEP_DAYS=30
