{
  "schema": "pipeline-session-kind/1",
  "kind": "code",
  "about": "One approved ticket's work, in a fresh workspace of its own, ending in one pull request.",
  "brief": "Do the work this ticket describes, in this workspace, and open one pull request.",
  "mode": "ticket",
  "branch": {"type": "feat", "word": "title"},
  "approval": {"newest_move": true, "states": "code"},
  "permissions": "deny-unlisted",
  "tools": ["Bash", "Read", "Edit", "Write"],
  "allow": {"Bash": "name", "Read": "workspace", "Edit": "workspace", "Write": "workspace"},
  "deny": ["store", "pins", "keys", "home"],
  "wall": "built-in-sandbox",
  "hosts": "project",
  "env": ["PATH", "HOME", "TMPDIR", "LANG", "CLAUDE_CODE_OAUTH_TOKEN", "DISABLE_AUTOUPDATER",
          "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"],
  "guards": ["pre-tool-use"],
  "tool_servers": [],
  "limits": {"wall_minutes": 360, "memory_mb": 8192, "disk_mb": 20480}
}
