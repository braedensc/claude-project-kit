{
  "schema": "pipeline-session-kind/1",
  "kind": "acceptance",
  "about": "Builds a finished plan's app and checks it, as the plan's acceptance check. It changes no code.",
  "brief": "Check the plan this ticket describes, as its acceptance check. Change nothing.",
  "mode": "diagnosis",
  "branch": {"type": "chore", "word": "acceptance"},
  "approval": {"newest_move": false, "states": "acceptance"},
  "permissions": "deny-unlisted",
  "tools": ["Bash", "Read"],
  "allow": {"Bash": "name", "Read": "workspace"},
  "deny": ["store", "pins", "keys", "home"],
  "wall": "built-in-sandbox",
  "hosts": "project",
  "env": ["PATH", "HOME", "TMPDIR", "LANG", "CLAUDE_CODE_OAUTH_TOKEN", "DISABLE_AUTOUPDATER",
          "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"],
  "guards": ["pre-tool-use"],
  "tool_servers": [],
  "limits": {"wall_minutes": 180, "memory_mb": 8192, "disk_mb": 20480}
}
