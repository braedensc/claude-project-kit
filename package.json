{
  "name": "claude-project-kit",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "description": "Full-stack project template: Claude Code hook suite, CI/CD patterns, 3-layer security model, process docs — distilled from a production build",
  "type": "module",
  "scripts": {
    "test:hooks": "python3 .claude/hooks/test_hooks.py",
    "test:dor": "python3 scripts/check_ticket_dor.py --selftest",
    "test:delivery": "python3 scripts/check_delivery_config.py --selftest",
    "test:jsonschema": "python3 scripts/jsonschema_mini.py --selftest",
    "test:schemas": "python3 scripts/check_schemas.py --selftest",
    "test:approve": "python3 scripts/check_auto_approve.py --selftest",
    "test:merge": "python3 scripts/check_auto_merge.py --selftest",
    "test:telemetry": "python3 scripts/telemetry_scrape.py --selftest",
    "test:dashboard": "python3 scripts/telemetry_dashboard.py --selftest",
    "test:review": "python3 scripts/check_weekly_review.py --selftest",
    "lint:secrets": "git ls-files -z | xargs -0 secretlint --secretlintrc .secretlintrc.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "husky": "^9.1.7",
    "secretlint": "^13.0.2"
  }
}
