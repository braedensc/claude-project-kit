{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/braedensc/claude-project-kit/schemas/pipeline-day-plan.schema.json",
  "title": "Pipeline day plan file",
  "description": "The machine-readable definition of docs/PIPELINE-CONTRACT.md §18 — the one file the morning planner writes, through scripts/pipeline_day_plan.py, and keeps current through the day: who planned the day, the working window, the day's budget, each lane and its pieces, what waits on the owner and the exact reply that clears it, the agent-filed tickets that start by themselves, the picks the checks dropped, and what holds new starts. The stand-up and the tech lead read it with no model in between; nothing reads it to start, approve or merge (KIT-438).",
  "$comment": "FIELDS ONLY. Every value is an id, a cleaned title, a number, a word from a closed list, a time, or a reply built by code from one of two fixed patterns. A cleaned title is one line, at most 120 characters, with no angle bracket, ampersand, pipe, backtick, or control, format or other hidden character: it is the only text from a ticket that reaches this file.",

  "type": "object",
  "required": ["schema", "written_at", "date", "planned_by", "window", "budget", "lanes", "needs_ok",
               "agent_filed", "dropped", "stops", "counts"],
  "additionalProperties": false,

  "properties": {
    "schema": {
      "const": "pipeline-day-plan/1",
      "description": "The marker. A reader that does not know it refuses the file."
    },
    "written_at": {"$ref": "#/$defs/time"},
    "date": {"$ref": "#/$defs/date"},
    "planned_by": {
      "description": "`agent`: its picks, checked by code, made the lanes. `queue`: the plain queue planned the day, and `why` says why the agent did not plan.",
      "oneOf": [
        {
          "type": "object",
          "required": ["who", "why"],
          "additionalProperties": false,
          "properties": {"who": {"const": "agent"}, "why": {"type": "null"}}
        },
        {
          "type": "object",
          "required": ["who", "why"],
          "additionalProperties": false,
          "properties": {
            "who": {"const": "queue"},
            "why": {"enum": ["no-answer", "too-long", "no-block", "several-blocks", "unreadable", "nothing-valid", "nothing-admitted", "off"]}
          }
        }
      ]
    },
    "window": {
      "type": "object",
      "required": ["state", "opens_at", "closes_at"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["open", "closed", "unknown"], "description": "`closed`: `opens_at` is the next opening. `unknown`: the window could not be read, and nothing is guessed."},
        "opens_at": {"$ref": "#/$defs/time_or_null"},
        "closes_at": {"$ref": "#/$defs/time_or_null"}
      }
    },
    "budget": {
      "type": "object",
      "required": ["planned", "stop", "spent", "estimated"],
      "additionalProperties": false,
      "description": "Dollars are the SDK's own estimate at API prices: a measure of plan use, never a bill.",
      "properties": {
        "planned": {"type": "number", "exclusiveMinimum": 0},
        "stop": {"type": "number", "exclusiveMinimum": 0},
        "spent": {"$ref": "#/$defs/usd_or_null", "description": "Null when the usage file could not be read: never zero."},
        "estimated": {"$ref": "#/$defs/usd"}
      }
    },
    "lanes": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/lane"}},
    "needs_ok": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/need"}},
    "agent_filed": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/ticket_id"},
          "source": {"$ref": "#/$defs/ticket_id_or_null"}
        }
      }
    },
    "dropped": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/ticket_id_or_null"},
          "reason": {"enum": ["not-in-pool", "duplicate", "wrong-repo", "blocker-order", "lane-cap", "overlap", "bad-footprint", "over-load"]}
        }
      }
    },
    "stops": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["stop", "ref", "value", "limit"],
        "additionalProperties": false,
        "properties": {
          "stop": {"enum": ["usage-missing", "usage-failed", "usage-stale", "ledger-unknown", "plan-near-limit", "plan-at-limit", "day-hard-stop", "piece-cost", "too-many-running", "too-many-starts", "api-key"]},
          "ref": {"type": ["string", "null"], "maxLength": 100, "pattern": "^[A-Za-z0-9_./#:-]+$(?![\\s\\S])"},
          "value": {"type": ["number", "null"]},
          "limit": {"type": ["number", "null"]}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["lanes", "pieces", "planned", "started", "done", "held", "unplaced", "needs_ok", "agent_filed", "stops", "dropped"],
      "additionalProperties": false,
      "description": "`planned`, `started`, `done` and `held` add up to `pieces`, the pieces in the lanes. `unplaced` are held pieces that name no repository.",
      "properties": {
        "lanes": {"$ref": "#/$defs/count"},
        "pieces": {"$ref": "#/$defs/count"},
        "planned": {"$ref": "#/$defs/count"},
        "started": {"$ref": "#/$defs/count"},
        "done": {"$ref": "#/$defs/count"},
        "held": {"$ref": "#/$defs/count"},
        "unplaced": {"$ref": "#/$defs/count"},
        "needs_ok": {"$ref": "#/$defs/count"},
        "agent_filed": {"$ref": "#/$defs/count"},
        "stops": {"$ref": "#/$defs/count"},
        "dropped": {"$ref": "#/$defs/count"}
      }
    }
  },

  "$defs": {
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"},
    "time_or_null": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"},
    "count": {"type": "integer", "minimum": 0},
    "usd": {"type": "number", "minimum": 0},
    "usd_or_null": {"type": ["number", "null"], "minimum": 0},
    "ticket_id": {"type": "string", "maxLength": 26, "pattern": "^[A-Z][A-Z0-9]{0,15}-[0-9]{1,9}$(?![\\s\\S])"},
    "ticket_id_or_null": {"type": ["string", "null"], "maxLength": 26, "pattern": "^[A-Z][A-Z0-9]{0,15}-[0-9]{1,9}$(?![\\s\\S])"},
    "repo": {"type": "string", "maxLength": 201, "pattern": "^[A-Za-z0-9_.-]{1,100}(/[A-Za-z0-9_.-]{1,100})?$(?![\\s\\S])"},
    "title_or_null": {
      "type": ["string", "null"],
      "maxLength": 120,
      "pattern": "^[^<>&|`\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u206f\\ufe00-\\ufe0f\\ufeff\\ufff9-\\ufffb]*$(?![\\s\\S])",
      "description": "Cleaned like §16's titles. Null when the ticket has none, or it is not a ticket."
    },
    "reply_or_null": {
      "type": ["string", "null"],
      "maxLength": 40,
      "pattern": "^(?:start|approve) [A-Z][A-Z0-9]{0,15}-[0-9]{1,9}$(?![\\s\\S])",
      "description": "Null, or exactly `start <ID>` or `approve <ID>`: built by code, never copied."
    },
    "lane": {
      "type": "object",
      "required": ["id", "repo", "pieces"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "maxLength": 205, "pattern": "^[A-Za-z0-9_.-]{1,100}(/[A-Za-z0-9_.-]{1,100})?:[0-9]{1,3}$(?![\\s\\S])"},
        "repo": {"$ref": "#/$defs/repo"},
        "pieces": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/piece"}}
      }
    },
    "piece": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "title", "estimate", "state", "held"],
          "additionalProperties": false,
          "properties": {
            "id": {"$ref": "#/$defs/ticket_id"},
            "title": {"$ref": "#/$defs/title_or_null"},
            "estimate": {"$ref": "#/$defs/usd_or_null"},
            "state": {"enum": ["planned", "started", "done"]},
            "held": {"type": "null"}
          }
        },
        {
          "type": "object",
          "required": ["id", "title", "estimate", "state", "held"],
          "additionalProperties": false,
          "properties": {
            "id": {"$ref": "#/$defs/ticket_id"},
            "title": {"$ref": "#/$defs/title_or_null"},
            "estimate": {"$ref": "#/$defs/usd_or_null"},
            "state": {"const": "held"},
            "held": {"enum": ["malformed", "no-repo", "no-estimate", "blockers-unreadable", "blocked", "stopped", "no-lane", "running-cap", "starts-cap", "agent-filed-cap", "over-load"]}
          }
        }
      ]
    },
    "need": {
      "type": "object",
      "required": ["kind", "ref", "title", "holds_up", "reply", "urgent"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["plan", "agent_filed", "changed", "approval", "merge", "question"]},
        "ref": {"type": "string", "maxLength": 220, "pattern": "^[A-Za-z0-9_.-]{1,100}(?:/[A-Za-z0-9_.-]{1,100})?(?:#[0-9]{1,9})?$(?![\\s\\S])"},
        "title": {"$ref": "#/$defs/title_or_null"},
        "holds_up": {
          "type": "object",
          "required": ["pieces", "usd"],
          "additionalProperties": false,
          "properties": {"pieces": {"$ref": "#/$defs/count"}, "usd": {"$ref": "#/$defs/usd"}}
        },
        "reply": {"$ref": "#/$defs/reply_or_null"},
        "urgent": {"type": "boolean"}
      }
    }
  }
}
