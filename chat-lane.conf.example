# chat-lane.conf.example — the values the chat-lane composer asks you for.
#
# ---------------------------------------------------------------------------
# HOW TO USE THIS FILE
#
#   cp chat-lane.conf.example chat-lane.conf && chmod 600 chat-lane.conf
#   $EDITOR chat-lane.conf                                    # none of them secret
#   python3 scripts/pipeline_chat_lane_setup.py compose       # prints every piece
#   python3 scripts/pipeline_chat_lane_setup.py verify        # after you apply them
#
# Every command checks this file first and reports EVERY bad value in one pass.
# `compose` prints and `verify` reads. Three subcommands write, as the role
# account, only when you run them: `merge --apply`, `env-names` and
# `front-door --apply`. None of them restarts anything. The steps are in
# docs/CHAT-LANE-OPERATOR.md.
#
# SINCE THE CUTOVER (KIT-492): the tech lead answers in the bridge's own DM,
# and the dispatcher keeps dev sessions only. Keep this lane off: card CK-C6
# turns it off. This file still drives `verify` and the lane's guards.
#
# ---------------------------------------------------------------------------
# WHAT THIS FILE IS, AND WHAT IT MAY NEVER BE
#
#   FORMAT.  `KEY=value`, one per line.  `#` starts a comment ONLY at the start
#   of a line.  It is PARSED, never SOURCED.  A duplicate key is an error.
#
#   NO KEY HERE EVER HOLDS A CREDENTIAL.  The loader refuses a value with a
#   credential shape and names the KEY only.  The chat app's token and signing
#   secret go into the dispatcher's env file through `env-names`, which asks for
#   them at hidden prompts, and nowhere else.
#
#   MODE 600.  It holds no secret, but it holds the shape of your deployment.
#   `chat-lane.conf` is gitignored; this example is committed.  Every value
#   below is reserved or invented (`example.com`, the namespaced `_exdispatch`).
# ---------------------------------------------------------------------------


# The local account the dispatcher runs as. `verify` reads four files as this
# account, through `sudo -u`, and the three writing subcommands write as it.
# Never your own login.
ROLE_ACCOUNT=_exdispatch

# The dispatcher's config file, as an absolute path. The chat grant and the
# Slack fence go in here. `merge --apply` writes them, in place.
DISPATCHER_CONFIG=/opt/example-dispatcher/config.json

# The env file the dispatcher loads, as an absolute path. By default that is
# `.env` in the dispatcher's home. The four chat-lane names go in here, through
# `env-names`.
DISPATCHER_ENV_FILE=/opt/example-dispatcher/.env

# The public host name of your front door (the reverse proxy). Host name only:
# no https://, no path. The Slack app's request URL becomes
# https://<this>/slack-webhook.
FRONT_DOOR_HOST=chat.example.com

# The TCP port the dispatcher listens on. The composed packet-filter rule refuses
# this port to every network interface except loopback. It must match the
# dispatcher's CYRUS_SERVER_PORT, which is 3456 when unset; `verify` compares the
# two without reading the value.
DISPATCHER_PORT=3456

# The NAME of the notifier's own token variable: notifier.conf's CHAT_TOKEN_ENV.
# `verify` checks that this name is NOT in the dispatcher's env file: every
# dispatcher session inherits that file, and the notifier's token must never
# reach one. Leave the default unless your notifier uses a different name.
NOTIFIER_TOKEN_ENV=NOTIFIER_SLACK_BOT_TOKEN

# The role account's OWN env file: the one the Stage E installer and the notifier
# keep their keys in (notifier.conf's ENV_FILE). `env-names` compares the chat
# token with every value in it, only to refuse the notifier's token as the chat
# app's. It will not guess: when this file is missing or unreadable, env-names
# writes nothing and exits 4; when it has no NOTIFIER_TOKEN_ENV line, it says so.
# Piece 5 denies it to the chat lane's Read tool. `~/` means the ROLE account's
# home, not yours.
#
# RULE: an absolute path, or one starting `~/`. The default is the one both
# installers use.
ROLE_ENV_FILE=~/.stage-e/env

# RETIRED (KIT-492): CHAT_RULES, BRIDGE_DM_QUESTIONS, BRIDGE_WAKES,
# IDEA_TEAM_KEYS and HEALTH_STATUS_FILE set piece 8, the chat bot's rules,
# which went with the cutover. A conf that still has them loads; `compose` and
# `verify` name the lines to take out.

# ---------------------------------------------------------------------------
# OPTIONAL — the printed restarts and the front-door subcommand need these.
# Leave one unset and every command that needs it prints
# `not composed: set <KEY> in chat-lane.conf`, and a subcommand that needs it
# refuses, naming it. Nothing is guessed.
# ---------------------------------------------------------------------------

# The launchd label of the dispatcher's own system daemon: the name
# `launchctl print system/<label>` finds. Card CK-C5 restarts it (only when it
# answers idle), and reads its log's path from the plist's StandardOutPath.
# The same key, and the same value, as stage-e.conf.
#
# RULE: reverse-DNS, at least two dot-separated segments.
DISPATCHER_SERVICE=com.example.dispatcher

# The launchd label of the front door's system daemon. Card CK-C2 restarts it
# after `front-door --apply`.
#
# RULE: reverse-DNS, and not the same as DISPATCHER_SERVICE.
FRONT_DOOR_SERVICE=com.example.front-door

# The front door's config file, as an absolute path: the one holding its path
# allowlist line (below). `front-door` reads and writes it as ROLE_ACCOUNT, so
# that account must own it. `verify` reads it for the front-door row.
FRONT_DOOR_CONFIG=/opt/example-dispatcher/Caddyfile

# The front door's own binary, as an absolute path. `front-door --apply` runs
# `<this> validate --config <FRONT_DOOR_CONFIG> --adapter caddyfile` after its
# edit, and puts the backup back if that fails.
FRONT_DOOR_BIN=/opt/homebrew/bin/caddy

# The named matcher whose ONE line is the allowlist, as it is written in
# FRONT_DOOR_CONFIG: `<matcher> path /one /two ...`. `front-door` refuses when it
# finds no such line, or two.
#
# RULE: `@` and then letters, digits, `_` or `-`.
FRONT_DOOR_MATCHER=@dispatcher

# Optional (KIT-348). The status job's file, where every plan stands, readable by the
# role account. Piece 5 allows a chat session to read this one file. Unset, it is
# the status job's default, ~/.stage-e/status/pipeline-status.json.
#
# RULE: an absolute path.
#PIPELINE_STATUS_FILE=/Users/Shared/pipeline-status/pipeline-status.json

# Optional (KIT-469). The kit's guides, readable by the role account. Piece 5 allows a
# chat session to read each guide, one exact file each. Unset, they are the role
# account's own clone, ~/.stage-e/kit/docs.
#
# RULE: an absolute path.
#KIT_DOCS_DIR=/Users/Shared/kit/docs

# Optional (KIT-257). Trust files a SANDBOXED session's own tools must read,
# comma-separated. Piece 5 puts them in the role account's user settings, under
# sandbox.filesystem.allowRead, and adds no other allow of any kind.
#
# Why it exists: in a sandboxed session (a coding session the dispatcher
# starts), piece 5's Read denies also block every shell command and every
# process it starts, at the operating-system level. Read(//**/*.pem) then hides
# the dispatcher's egress CA certificate from git, and a push fails. The deny
# stays, because a private key can sit beside that certificate with a .pem
# name. Name the certificate here instead: that one file is re-opened, nothing
# else.
#
# Leave it unset unless a sandboxed push or fetch fails with "error setting
# certificate verify locations". Unset, no trust file is allowed.
#
# RULE: each an absolute path to one file. No glob (* ? [ ] { }), no ..
# segment, no trailing slash, no "key" in the file name, not .key, and not a
# file piece 5 denies: the dispatcher's config and env file, or the role
# account's env file, its copies and its backups, under any home. Every bad
# entry is named, all at once.
#SANDBOX_TRUST_FILES=/opt/example-dispatcher/certs/egress-ca.pem

# Optional (KIT-385). The model the dispatcher's chat turns run on. `merge` writes
# it as the dispatcher's claudeDefaultModel, with CHAT_BACKUP_MODEL as
# claudeDefaultFallbackModel, in one write. Unset, merge leaves the pair alone.
#
# That pair is also every ticket's model unless the ticket carries a [model=…]
# tag or a model label. So set TICKET_MODEL in stage-a.conf and stage-e.conf
# first, and move it with scripts/pipeline_model_switch.py, which does both in
# order (card CK-C8). To go back, run the switch with --to set to the model
# tickets keep; taking CHAT_MODEL out is not undo.
#
# RULE: fable, opus, sonnet, haiku or a claude- model id. One plain name: not
# the [1m] suffix, and not a list.
#CHAT_MODEL=sonnet

# Optional. The backup for CHAT_MODEL. Unset, it is the backup the dispatcher
# picks for that model's alias, by family: fable backs up to opus, opus to
# sonnet, sonnet to haiku, haiku to sonnet.
#
# RULE: as CHAT_MODEL, and not the same name: the SDK refuses a backup equal
# to its model, and every chat turn would fail before it starts. Two names of
# one family (sonnet and claude-sonnet-5-5) are allowed, but may be one model,
# which backs up nothing: verify notes that.
#CHAT_BACKUP_MODEL=haiku
