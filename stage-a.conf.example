# stage-a.conf.example — every value the Stage A (idea-gate) installer reads.
#
# ---------------------------------------------------------------------------
# HOW TO USE THIS FILE
#
#   You usually never edit it. On a first run the installer writes stage-a.conf
#   for you: it works out most values from the review installer's own settings
#   (stage-e.conf), from this checkout and from your Linear key, and asks only
#   for the rest. The one command that does it, typed in a terminal:
#
#     python3 scripts/pipeline_install.py
#
#   To fill it by hand instead:
#
#     cp stage-a.conf.example stage-a.conf && chmod 600 stage-a.conf
#     $EDITOR stage-a.conf                              # none of these values is secret
#
# The installer validates the file before it touches anything, and reports EVERY
# bad value in one pass — not the first one it meets.
#
# ---------------------------------------------------------------------------
# WHAT THIS FILE IS, AND WHAT IT MAY NEVER BE
#
#   FORMAT.  `KEY=value`, one per line.  `#` starts a comment ONLY at the start
#   of a line.  It is PARSED, never SOURCED — no `$(…)`, no backticks, no export.
#
#   NO KEY HERE EVER HOLDS A CREDENTIAL.  Keys are named here, never valued.
#
#   MODE 600.  It holds no secret, but it holds the shape of your deployment.
#   `stage-a.conf` is gitignored; this example is committed.  Every value below
#   is synthetic (`example.com`, `example-org`); edit them all.
#
#   THERE IS NO PLANNING TEAM.  Planning happens on each repository's own work
#   team: you move an idea to "Plan it" on that team.  Which team a repository
#   plans on is read from its own delivery.json, never typed here.
# ---------------------------------------------------------------------------


# The local account the planner job runs as — NOT your login. A job under your login
# could be read by every Claude session you run, and stops when you log out. The usual
# choice is the dispatcher's own account, which the review jobs already run as: the
# first run fills it in from stage-e.conf. The installer never creates accounts.
ROLE_ACCOUNT=_exdispatch

# The repositories whose ideas are planned, as owner/repo, separated by commas.
# Each one's COMMITTED delivery.json, on its default branch, says which work team
# its ideas sit on (`linear.teamKey`) and is the executor's only config for it. When
# that file does not switch plans on yet, the installer shows the change, opens the
# pull request AS YOU, and waits for you to merge it. It never merges.
#
# RULE: one team plans one repository. The dispatcher sends a team's tickets to
# exactly one repository, so two repositories whose delivery.json name the same team
# are refused. The first run suggests the repositories the review jobs watch.
PLANNED_REPOS=example-org/product

# Your own Linear USER ID — the person notified on every filed plan, and the only
# person the planning entries let start a session. The first run reads it from your key.
OWNER_USER_ID=REPLACE_WITH_YOUR_LINEAR_USER_ID

# The NAME — never the value — of the variable holding YOUR tracker key in the terminal
# you run the installer from. It creates the Plan it state and the routing label, and
# files and reads the probe tickets as you. It is never stored. When it is not set, and
# the planner reuses the review jobs' key (LINEAR_KEY_FILE below), the installer reads
# that stored key instead; otherwise it asks at a hidden prompt.
OPERATOR_KEY_ENV=LINEAR_API_KEY

# The NAME — never the value — of the variable the planner job's key is stored under.
# It must be a PERSONAL key of yours: the planning entries let only you start a session,
# and the dispatcher checks who handed the ticket over.
LINEAR_KEY_ENV=STAGE_E_LINEAR_API_KEY

# OPTIONAL. The env file, under ROLE_ACCOUNT's home, that holds that key.
#   .stage-e/env  — reuse the key the review jobs already store (the first run's
#                   choice when stage-e.conf exists). Nothing is asked for; the review
#                   installer owns that file, and revoking that key stops both.
#   .stage-a/env  — a key of the planner's own, asked for once at a hidden prompt.
# Default: .stage-a/env
LINEAR_KEY_FILE=.stage-e/env

# The https clone URL the role account runs the planner job out of. The installer places
# that clone under the role account and keeps it level with origin. Not ssh — the role
# account has no keys. The first run takes it from stage-e.conf or this checkout.
KIT_REPO_URL=https://github.com/example-org/claude-project-kit

# The display name of the dispatcher's agent user in the tracker. The planner job
# delegates every planning ticket to it. It must be an app user, not a person. The first
# run takes it from stage-e.conf (AGENT_DISPLAY_NAME).
AGENT_USER_NAME=Dispatcher Agent

# The launchd label for the planner job: reverse-DNS, at least two parts. The job is
# installed at /Library/LaunchDaemons/<this>.plist and started only after your yes. The
# first run puts it beside the dispatcher's own label.
JOB_LABEL=com.example.stage-a-planner

# The local account the dispatcher itself runs as. The installer reads the dispatcher's
# config as that account — as FACTS, because it holds the dispatcher's tracker tokens —
# and writes the planning entries into it as that account, after a backup and your typed
# yes.
DISPATCHER_ACCOUNT=_exdispatch

# The dispatcher's own config file, by absolute path.
DISPATCHER_CONFIG=/opt/example-dispatch/config.json

# The dispatcher's launchd label. After writing the planning entries the installer
# restarts it (stop, wait until launchd lets go, start) so it loads them — and warns you
# first, because a restart cuts off any session it is running.
DISPATCHER_SERVICE=com.example.dispatcher

# OPTIONAL. The state, on each work team, you move an idea into to start a planning
# run. The installer creates it as a to-do (unstarted) state if it is absent, and
# refuses one of this name of any other type. Default: Plan it
PLAN_IT_STATE=Plan it

# OPTIONAL. How often the planner job runs, in seconds (60 to 3600). Default: 300
POLL_INTERVAL_SECONDS=300

# OPTIONAL. How many planning runs may start in one day (UTC), across every team
# (1 to 100). A limit on what a mis-drag or a bulk status change can cost. Default: 10
MAX_RUNS_PER_DAY=10

# OPTIONAL. How long, in seconds, the planner job waits for the dispatcher's routing
# note after filing a planning ticket (30 to 300). No note in time counts as a routing
# failure, which cancels the ticket and stops planning. Default: 120
ROUTING_WAIT_SECONDS=120

# OPTIONAL. The port the dispatcher listens on, on this machine. The planner job reads
# the dispatcher's version from it on every pass, and refuses to plan on a version the
# probe was not signed on. Default: 3456
DISPATCHER_PORT=3456

# OPTIONAL. The absolute path of the dispatcher's installed routing code
# (RepositoryRouter.js inside its cyrus-edge-worker package). When set, the probe
# records its fingerprint and `verify` checks it has not changed. Leave empty to rely on
# the version alone.
DISPATCHER_ROUTER_FILE=

# OPTIONAL, and only for PRIVATE planned repositories. The NAME — never the value — of
# the variable holding a read-only code-host token, so the job can update its checkout
# of each planned repository. Asked for at a hidden prompt and stored in
# ~/.stage-a/env under the role account. Leave empty when every one is public.
GITHUB_TOKEN_ENV=
