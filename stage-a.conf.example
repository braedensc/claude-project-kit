# stage-a.conf.example — every value the Stage A (idea-gate) installer asks you for.
#
# ---------------------------------------------------------------------------
# HOW TO USE THIS FILE
#
#   cp stage-a.conf.example stage-a.conf && chmod 600 stage-a.conf
#   $EDITOR stage-a.conf                              # none of these values is secret
#   python3 scripts/pipeline_stage_a_setup.py run     # the only command you type
#
# `run` validates this file before it touches anything, and reports EVERY bad
# value in one pass — not the first one it meets. Fix them all, run it again.
#
# ---------------------------------------------------------------------------
# WHAT THIS FILE IS, AND WHAT IT MAY NEVER BE
#
#   FORMAT.  `KEY=value`, one per line.  `#` starts a comment ONLY at the start
#   of a line.  It is PARSED, never SOURCED — no `$(…)`, no backticks, no export.
#
#   NO KEY HERE EVER HOLDS A CREDENTIAL.  The executor's Linear key is named
#   here, never valued: the installer writes the value into the role account's
#   own env file at mode 600, and this file records only the env-var NAME.
#
#   MODE 600.  It holds no secret, but it holds the shape of your deployment.
#   `stage-a.conf` is gitignored; this example is committed.  Every value below
#   is synthetic (`example.com`, the namespaced `_planclaw`); edit them all.
#
#   THERE IS NO PLANNING TEAM.  Planning happens on each repository's own work
#   team: you move an idea to "Plan it" on that team.  Which team a repository
#   plans on is read from its own delivery.json, never typed here.
# ---------------------------------------------------------------------------


# The non-admin local account the executor runs as — NOT your login. A job under
# your login stops when you log out; the executor would then file no plans while
# the dispatcher kept starting planning sessions. The installer never creates it.
ROLE_ACCOUNT=_planclaw

# The repositories whose ideas are planned, as owner/repo, separated by commas.
# Each one's COMMITTED delivery.json, on its default branch, says which work team
# its ideas sit on (`linear.teamKey`) and is the executor's only config for it: the
# team the tree lands in, that team's state and label ids, and the
# `linear.findingTicket` block that turns plans on. The installer reads that file and
# never writes it.
#
# RULE: one team plans one repository. The dispatcher sends a team's tickets to
# exactly one repository, so two repositories whose delivery.json name the same team
# are refused.
PLANNED_REPOS=example-org/product

# Your own Linear USER ID — the person notified on every filed plan and named as
# the subscriber on each epic. A plan nobody is notified about dies in the
# backlog. This is the user id, not an email.
OWNER_USER_ID=REPLACE_WITH_YOUR_LINEAR_USER_ID

# The NAME — never the value — of the variable holding YOUR tracker key, in the
# terminal you run the installer from. It creates the Plan it state and the routing
# label on each work team, and reads the probe tickets back. It is read, never stored.
OPERATOR_KEY_ENV=LINEAR_API_KEY

# The NAME — never the value — of the variable the EXECUTOR's key is stored under,
# in the role account's own env file (mode 600). A different key from yours, and a
# different name: one name for both is how your key ends up in the executor's file.
# The executor is started with `--key-env` set to this name.
LINEAR_KEY_ENV=STAGE_A_LINEAR_API_KEY

# The https clone URL the role account runs the planner job and the executor out of.
# The installer places that clone under the role account and keeps it level with origin,
# and the job execs from it on every pass. Not ssh — the role account has no keys.
KIT_REPO_URL=https://github.com/example-org/claude-project-kit

# The display name of the dispatcher's agent user in the tracker. The planner job
# delegates every planning ticket to it, in the same call that creates the ticket, so a
# session's own identity is never in the loop. It must be an app user, not a person.
AGENT_USER_NAME=Dispatcher Agent

# The launchd label for the planner job. A label belongs to a deployment, never to this
# repository, so you type it: reverse-DNS, at least two parts. The job is installed at
# /Library/LaunchDaemons/<this>.plist and is never loaded by the installer.
JOB_LABEL=com.example.stage-a-planner

# OPTIONAL. The state, on each work team, you move an idea into to start a planning
# run. The installer creates it as a to-do (unstarted) state if it is absent, and
# refuses one of this name of any other type. Default: Plan it
PLAN_IT_STATE=Plan it

# OPTIONAL. How often the planner job runs, in seconds (60 to 3600). Default: 300
POLL_INTERVAL_SECONDS=300

# OPTIONAL. How many planning runs may start in one day (UTC), across every team
# (1 to 100). A limit on what a mis-drag or a bulk status change can cost. Default: 10
MAX_RUNS_PER_DAY=10

# OPTIONAL. How long, in seconds, the planner job waits for the dispatcher's routing
# note after filing a planning ticket (30 to 300). No note in time counts as a routing
# failure, which cancels the ticket and stops planning. The wait stretches by itself
# while a repository setup script runs. Default: 120
ROUTING_WAIT_SECONDS=120

# OPTIONAL. The port the dispatcher listens on, on this machine. The planner job reads
# the dispatcher's version from it on every pass, and refuses to plan on a version the
# probe was not signed on. Default: 3456
DISPATCHER_PORT=3456

# OPTIONAL. The absolute path of the dispatcher's installed routing code
# (RepositoryRouter.js inside its cyrus-edge-worker package). When set, the probe
# records its fingerprint, read as the dispatcher's account, and `verify` checks it has
# not changed. Leave empty to rely on the version alone.
DISPATCHER_ROUTER_FILE=

# OPTIONAL, and only for PRIVATE planned repositories. The NAME — never the value — of
# the variable holding a read-only code-host token, so the job can update its checkout
# of each planned repository. The installer asks for the value at a hidden prompt and
# stores it beside the tracker key. Leave empty when every one is public.
GITHUB_TOKEN_ENV=

# The local account the dispatcher itself runs as. The installer reads that account's
# copy of the dispatcher config — as FACTS, never as a file, because it holds the
# dispatcher's tracker tokens — for the fields a loadable planning entry needs: the
# clone the planner reads code in, that clone's base branch, the workspace directory
# and the workspace id. It never writes that config.
#
# RULE: not the same account as ROLE_ACCOUNT. Every session can read what the
# dispatcher's account can read, and the executor's key must be out of that reach.
DISPATCHER_ACCOUNT=_exdispatch

# The dispatcher's own config file, by absolute path. A relative path is resolved
# against a working directory nothing here can see.
DISPATCHER_CONFIG=/opt/example-dispatch/config.json
