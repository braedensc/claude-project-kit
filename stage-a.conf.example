# stage-a.conf.example — every value the Stage A (idea-gate) installer asks you for.
#
# ---------------------------------------------------------------------------
# HOW TO USE THIS FILE
#
#   cp stage-a.conf.example stage-a.conf && chmod 600 stage-a.conf
#   $EDITOR stage-a.conf                              # six values, none of them secret
#   python3 scripts/pipeline_stage_a_setup.py run     # the only command you type
#
# `run` validates this file before it touches anything, and reports EVERY bad
# value in one pass — not the first one it meets. Fix them all, run it again.
#
# ---------------------------------------------------------------------------
# WHAT THIS FILE IS, AND WHAT IT MAY NEVER BE
#
#   FORMAT.  `KEY=value`, one per line.  `#` starts a comment ONLY at the start
#   of a line.  It is PARSED, never SOURCED — no `$(…)`, no backticks, no export.
#
#   NO KEY HERE EVER HOLDS A CREDENTIAL.  The executor's Linear key is named
#   here, never valued: the installer writes the value into the role account's
#   own env file at mode 600, and this file records only the env-var NAME.
#
#   MODE 600.  It holds no secret, but it holds the shape of your deployment.
#   `stage-a.conf` is gitignored; this example is committed.  Every value below
#   is synthetic (`example.com`, the namespaced `_planclaw`); edit them all.
# ---------------------------------------------------------------------------


# The non-admin local account the executor runs as — NOT your login. A job under
# your login stops when you log out; the executor would then file no plans while
# the dispatcher kept starting planning sessions. The installer never creates it.
ROLE_ACCOUNT=_planclaw

# The Linear team key you delegate idea tickets into. Being on this team routes an
# idea to the Planning entry — UNLESS the idea's own description carries a routing
# tag, or a label selects a prompt type, either of which outranks the team (KIT-154).
# Until that closes, write ideas yourself; never paste idea text from elsewhere.
# Must not be the planned repository's work team.
PLANNING_TEAM_KEY=PLAN

# Your own Linear USER ID — the person notified on every filed plan and named as
# the subscriber on each epic. A plan nobody is notified about dies in the
# backlog. This is the user id, not an email.
OWNER_USER_ID=REPLACE_WITH_YOUR_LINEAR_USER_ID

# The planned repository, as owner/repo. Its COMMITTED delivery.json, on its default
# branch, is the executor's only config: the work team the tree lands in, its state
# and label ids, and the `linear.findingTicket` block that turns plans on. The
# installer reads that file and never writes it; when it is not ready, it prints the
# exact block for you to add in a pull request of your own.
PLANNED_REPO=example-org/product

# The NAME — never the value — of the variable holding YOUR tracker key, in the
# terminal you run the installer from. It provisions the Planning team and the
# labels. It is read, never stored.
OPERATOR_KEY_ENV=LINEAR_API_KEY

# The NAME — never the value — of the variable the EXECUTOR's key is stored under,
# in the role account's own env file (mode 600). A different key from yours, and a
# different name: one name for both is how your key ends up in the executor's file.
# The executor is started with `--key-env` set to this name.
LINEAR_KEY_ENV=STAGE_A_LINEAR_API_KEY

# The https clone URL the role account runs the planner job and the executor out of.
# The installer places that clone under the role account and keeps it level with origin,
# and the job execs from it on every pass. Not ssh — the role account has no keys.
KIT_REPO_URL=https://github.com/example-org/claude-project-kit

# The display name of the dispatcher's agent user in the tracker. The planner job
# delegates every planning ticket to it, in the same call that creates the ticket, so a
# session's own identity is never in the loop. It must be an app user, not a person.
AGENT_USER_NAME=Dispatcher Agent

# The launchd label for the planner job. A label belongs to a deployment, never to this
# repository, so you type it: reverse-DNS, at least two parts. The job is installed at
# /Library/LaunchDaemons/<this>.plist and is never loaded by the installer.
JOB_LABEL=com.example.stage-a-planner

# OPTIONAL. The Planning team state you move an idea into to start a planning run. The
# installer creates it if it is absent, and refuses a state of this name that is a done
# state — moving an idea there is how a run STARTS. Default: Plan it
PLAN_IT_STATE=Plan it

# OPTIONAL. How often the planner job runs, in seconds (60 to 3600). Default: 300
POLL_INTERVAL_SECONDS=300

# OPTIONAL, and only for a PRIVATE planned repository. The NAME — never the value — of
# the variable holding a read-only code-host token, so the job can update its checkout
# of the planned repository. The installer asks for the value at a hidden prompt and
# stores it beside the tracker key. Leave empty for a public repository.
GITHUB_TOKEN_ENV=
