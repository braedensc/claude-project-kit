# The watcher's own install (scripts/pipeline_watcher_setup.py, KIT-517).  Copy to watcher.conf, mode 600.
# Names only: no key, token or password goes in this file.

# The account the watcher runs as: a NEW hidden local account, not root, not you, not the workers' account.
WATCHER_ACCOUNT=_clawwatcher
# The workers' account: the one the dispatcher's sessions run as.  The installer checks it cannot write the install.
ROLE_ACCOUNT=_clawdispatch
# A full 40-character commit id, one a person reviewed.  It must be on origin/main, and this checkout must be it.
KIT_COMMIT=REPLACE-WITH-THE-REVIEWED-COMMIT
# Your own reverse-DNS launchd label (not com.example.*).
JOB_LABEL=local.example-claw-watcher

# Root's folder (the files and rules), and the watcher's state folder (its status file, hold file and env file).
# System folders only: nowhere a user's session can write.
INSTALL_DIR=/usr/local/claw-watcher
STATE_DIR=/var/claw-watcher
PYTHON=/usr/bin/python3
INTERVAL_SECONDS=900

# What it watches: OWNER/REPO names, comma-separated, and the GitHub logins that may apply a protected label.
WATCH_REPOS=acme/app
TRUSTED_ACTORS=the-owners-login,github-actions[bot]
# The NAME of the variable that holds a READ-ONLY GitHub token.  The installer asks for the value at a hidden prompt.
GITHUB_TOKEN_ENV=WATCHER_GITHUB_TOKEN

# Optional: ticket text, first-hand (all three together, or none).  A READ-ONLY tracker key.
LINEAR_KEY_ENV=
TRACKER_TEAMS=
TRACKER_TRUSTED_USERS=

# Optional: the usage file the workers write (the SOURCE).  A small job of root's copies it each pass into root's copy
# folder and the watcher reads the copy, never your file (KIT-573).  Outside INSTALL_DIR and STATE_DIR.  Empty = no copier.
# The limits are the owner's decision (docs/WATCHER.md): empty = that monitor is off.
USAGE_FILE=
LIMIT_DAY_USD=
LIMIT_PIECE_USD=
LIMIT_DAY_RUNS=
LIMIT_PIECE_RUNS=

# Optional (KIT-782): the queue's, the morning job's and the sweep's heartbeat files, as the workers write them (the
# SOURCES: absolute, outside INSTALL_DIR and STATE_DIR).  The same copier copies each into root's copy folder, and the
# one command points the health check's QUEUE_/MORNING_/SWEEP_HEARTBEAT_FILE at the copies, so the health watch can say
# one stopped.  Where each job writes it: the queue's is queue-heartbeat.json in the bridge's state folder; the morning
# job's is morning-heartbeat.json beside its day plan; the sweep's is the file its sweep.json names as heartbeat_file
# (the sweep installer sets it to heartbeat.json beside sweep.json).  Empty = that job is off here, not watched.
QUEUE_HEARTBEAT=
MORNING_HEARTBEAT=
SWEEP_HEARTBEAT=

# Optional (KIT-933): the runner's word on the session writer's key, writer-key.json in the runner's store (its
# RUNNER_DIR's store/ folder), as the runner writes it.  The same copier copies it, and the one command points the
# health check's WRITER_KEY_STATUS_FILE at the copy, so the health watch says when the key could not be read or
# renewed, is near its end, or the runner went quiet.  Empty = not watched.
WRITER_KEY_STATUS=

# Optional (KIT-957): the bridge's chat-cap-trips.json (in its state folder; written only at the first trip) and the
# runner's incidents.json (in its store; written at the first incident), as the SOURCES.  The same copier copies each; a
# source that is not there yet is "absent", told apart from a copy it refused.  The one command points the health
# check's CHAT_CAP_TRIPS_FILE and RUNNER_INCIDENTS_FILE at the copies.  Empty = not watched.
CHAT_CAP_TRIPS=
RUNNER_INCIDENTS=

# Optional: the validator's ledger (docs/WATCHER.md, approval-rate).  With it, every merge into a watched
# repository is checked against the validator's approvals.  This account must be able to read the file.
# OWNER_LOGINS: your own GitHub logins, comma-separated: your own merges need no approval.  Leave yours out,
# and each of your merges holds new starts.  LIMIT_DAY_APPROVALS: the most approvals in 24 hours, a runaway's.
# LIMIT_APPROVALS_IN_A_ROW: the most decisions in a row that may all be approvals before you are paged, a runaway's.
VALIDATOR_LEDGER=
OWNER_LOGINS=
LIMIT_DAY_APPROVALS=
LIMIT_APPROVALS_IN_A_ROW=
